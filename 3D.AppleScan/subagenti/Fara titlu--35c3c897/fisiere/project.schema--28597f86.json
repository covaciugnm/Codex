{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva-org.com/schemas/project-1.json",
  "title": "EVA persistent project interchange manifest v1",
  "$comment": "Proposed contract. Schema validates structural constraints only. Application validates unique IDs, references, byte/hash content, CAS prefix agreement, UInt64 bound, date order, quaternion norm and calibration immutability. No live_ephemeral persistence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "kind",
    "state",
    "units",
    "created_at",
    "updated_at",
    "revision",
    "calibrations",
    "assets",
    "rooms",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": "eva-project/1"
    },
    "project_id": {
      "$ref": "#/$defs/uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "enum": [
        "object_persistent",
        "rooms_persistent"
      ]
    },
    "state": {
      "enum": [
        "draft",
        "captured",
        "processed"
      ]
    },
    "units": {
      "const": "m"
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "updated_at": {
      "$ref": "#/$defs/utc"
    },
    "revision": {
      "$ref": "#/$defs/sqlInteger"
    },
    "calibrations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/calibration"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "rooms": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "object_persistent"
          }
        }
      },
      "then": {
        "properties": {
          "rooms": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "captured",
              "processed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "assets": {
            "minItems": 1
          },
          "calibrations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "processed"
          },
          "kind": {
            "const": "object_persistent"
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "processed"
          },
          "kind": {
            "const": "rooms_persistent"
          }
        }
      },
      "then": {
        "properties": {
          "rooms": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./:-]{1,96}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation_m",
        "quaternion_xyzw"
      ],
      "properties": {
        "translation_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "quaternion_xyzw": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_id",
        "hardware_profile",
        "revision",
        "artifact_sha256",
        "created_at"
      ],
      "properties": {
        "calibration_id": {
          "$ref": "#/$defs/id"
        },
        "hardware_profile": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/sqlInteger"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/hash"
        },
        "created_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byte_length",
        "media_type",
        "cas_path"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "byte_length": {
          "$ref": "#/$defs/sqlInteger"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "cas_path": {
          "type": "string",
          "pattern": "^cas/[0-9a-f]{2}/[0-9a-f]{64}$"
        }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room_id",
        "name",
        "revision",
        "geometry_sha256",
        "frame_id",
        "project_from_room"
      ],
      "properties": {
        "room_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "$ref": "#/$defs/sqlInteger"
        },
        "geometry_sha256": {
          "$ref": "#/$defs/hash"
        },
        "frame_id": {
          "$ref": "#/$defs/id"
        },
        "project_from_room": {
          "$ref": "#/$defs/pose"
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "name",
        "model_sha256",
        "room_id",
        "revision",
        "frame_id",
        "state",
        "ambiguity_status",
        "pose"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_sha256": {
          "$ref": "#/$defs/hash"
        },
        "room_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "$ref": "#/$defs/sqlInteger"
        },
        "frame_id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": [
            "observed",
            "predicted",
            "occluded",
            "lost",
            "retired"
          ]
        },
        "ambiguity_status": {
          "enum": [
            "none",
            "pose",
            "identity",
            "both"
          ]
        },
        "pose": {
          "$ref": "#/$defs/pose"
        }
      }
    },
    "sqlInteger": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "description": "Canonical decimal integer 0 through 9223372036854775807 inclusive, compatible with local SQLite INTEGER."
    }
  }
}
